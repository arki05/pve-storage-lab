# MmAaXx500/pve-storage-plugin-bcachefs, run through the same rubric as any
# other backend. Not a competitor scoreboard: the interesting output is which
# differences are design choices and which are the same footgun twice.
#
# Its storage type is 'bcachefs', the same string pve-bcachefs registers, so
# the two cannot be installed side by side. This profile bakes onto the plain
# base image rather than onto pve-bcachefs's variant.
NAME=bcachefs-mm
# Three for the multi-device filesystem. No fourth: this plugin has no
# project-quota path, so there is no quota-less fallback to exercise.
DISKS=3
