SUPPORTS_SNAPSHOTS=true
SUPPORTS_LINKED_CLONE=true
SUPPORTS_BACKUP=true
SUPPORTS_LXC=true
SUPPORTS_IMAGES=true
SUPPORTS_THIN_PROVISION=true
SUPPORTS_TPM=true
# A container rootfs is a dataset with a refquota, so the size is enforced and
# the container sees it as the size of its own filesystem.
ENFORCES_VOLUME_SIZE=true
SUPPORTS_VMSTATE=true
# A scrub reads every block and verifies its checksum; it runs online.
CONSISTENCY_CHECK=zpool scrub -w labpool && zpool status -x labpool | grep -q "pool 'labpool' is healthy"
# ZFS rolls back to the most recent snapshot only. Going further means
# destroying the ones in between, and it refuses rather than doing that
# silently - so "roll back to last Tuesday" is not a thing here.
ROLLBACK_PAST_NEWER_SNAPSHOTS=false
VM_RESIZE_VISIBLE_IN_GUEST=true
CT_RESIZE_VISIBLE_IN_GUEST=true
