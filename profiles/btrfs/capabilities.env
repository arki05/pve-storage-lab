SUPPORTS_SNAPSHOTS=true
SUPPORTS_LINKED_CLONE=false
SUPPORTS_BACKUP=true
SUPPORTS_LXC=true
SUPPORTS_IMAGES=true
SUPPORTS_THIN_PROVISION=true
SUPPORTS_TPM=true
# Without `quotas` on the storage, upstream allocates a subvolume with no
# qgroup limit - the configured size is recorded and not enforced. That is
# upstream's documented behaviour, not a bug to fail on here.
ENFORCES_VOLUME_SIZE=false
RESIZE_VISIBLE_IN_GUEST=false
SUPPORTS_VMSTATE=true
CONSISTENCY_CHECK=btrfs scrub start -B /mnt/lab-btrfs && btrfs scrub status /mnt/lab-btrfs | grep -q "no errors found"
