# A plain directory has no snapshot support and no linked clones. Most of the
# suite skips here - which is the point: it proves the skip logic works.
SUPPORTS_SNAPSHOTS=false
SUPPORTS_LINKED_CLONE=false
SUPPORTS_BACKUP=true
SUPPORTS_LXC=true
SUPPORTS_IMAGES=true
SUPPORTS_THIN_PROVISION=false
# A directory storage puts a container rootfs in a raw image, so the size is
# enforced by the image itself.
ENFORCES_VOLUME_SIZE=true
SUPPORTS_TPM=true
SUPPORTS_VMSTATE=false
ROLLBACK_PAST_NEWER_SNAPSHOTS=false
VM_RESIZE_VISIBLE_IN_GUEST=true
CT_RESIZE_VISIBLE_IN_GUEST=true
